<button
  class="theme-toggle-btn"
  type="button"
  data-theme-toggle
  aria-label="Switch to dark mode"
  title="Switch to dark mode"
>
  <svg class="theme-icon theme-icon-sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="8" cy="8" r="3" />
      <line x1="8" y1="1.5" x2="8" y2="3" />
      <line x1="8" y1="13" x2="8" y2="14.5" />
      <line x1="2.4" y1="2.4" x2="3.5" y2="3.5" />
      <line x1="12.5" y1="12.5" x2="13.6" y2="13.6" />
      <line x1="1.5" y1="8" x2="3" y2="8" />
      <line x1="13" y1="8" x2="14.5" y2="8" />
      <line x1="2.4" y1="13.6" x2="3.5" y2="12.5" />
      <line x1="12.5" y1="3.5" x2="13.6" y2="2.4" />
  </svg>
  <svg class="theme-icon theme-icon-moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M13.5 9.5a6 6 0 0 1-7-7 6 6 0 1 0 7 7z" />
  </svg>
</button>
