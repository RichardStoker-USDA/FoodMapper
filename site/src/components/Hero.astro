---
// The release line reads the newest Sparkle feed item, so the page and the
// in-app updater always name the same version. Publishing a feed item and
// rebuilding the site updates it; no hand edit is needed.
import appcast from '../../public/appcast.xml?raw';

const latestItem = appcast.match(/<item>([\s\S]*?)<\/item>/)?.[1] ?? '';
const feedField = (name: string) =>
  latestItem.match(new RegExp(`<sparkle:${name}>([^<]+)</sparkle:${name}>`))?.[1]?.trim();

const latestVersion = feedField('shortVersionString');
const releaseNotesURL = feedField('releaseNotesLink');
const minimumSystem = feedField('minimumSystemVersion');
const hardware = feedField('hardwareRequirements');
if (!latestVersion || !releaseNotesURL || !minimumSystem) {
  throw new Error('site/public/appcast.xml needs a complete newest item for the hero release line.');
}
const releaseNotesPath = new URL(releaseNotesURL).pathname;
const macOSMajor = minimumSystem.split('.')[0];
---

<section class="hero section">
  <div class="container hero-content">
    <div class="hero-identity">
      <img
        src="/images/app-icon-large.png"
        alt="FoodMapper app icon"
        class="hero-icon"
        width="96"
        height="96"
      />
      <h1 class="text-hero hero-title">FoodMapper</h1>
    </div>

    <p class="hero-tagline">
      Match free-text food descriptions to standardized reference databases
      with on-device MLX models on Apple Silicon.
    </p>

    <p class="hero-subtext text-secondary">
      Designed for nutrition research. Matching runs on your Mac, and the
      installer needs no administrator password.
    </p>

    <div class="hero-cta">
      <a
        href="https://github.com/RichardStoker-USDA/FoodMapper/releases/latest/download/FoodMapper.pkg"
        class="download-btn"
      >
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 3v10m0 0l-3.5-3.5M10 13l3.5-3.5" />
          <path d="M3 14v2a1 1 0 001 1h12a1 1 0 001-1v-2" />
        </svg>
        Download for Mac
      </a>
    </div>

    <p class="hero-release">
      <a href={releaseNotesPath}>What's new in {latestVersion}</a>
      <span>macOS {macOSMajor} or later{hardware === 'arm64' && ' on Apple Silicon'}</span>
    </p>

    <a
      class="hero-publication"
      href="https://doi.org/10.1016/j.tjnut.2026.101678"
      target="_blank"
      rel="noopener"
    >
      Published in <em>The Journal of Nutrition</em>
      <span aria-hidden="true">↗</span>
    </a>

    <div class="hero-screenshot-wrapper">
      <figure class="screenshot-card hero-screenshot">
        <img
          class="hero-screenshot theme-screenshot"
          src="/images/hero-home-light.png"
          data-light-src="/images/hero-home-light.png"
          data-dark-src="/images/hero-home-dark.png"
          alt="FoodMapper home screen showing match setup and configuration"
          width="1470"
          height="956"
          loading="eager"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: var(--space-hero-top, 64px);
    padding-bottom: var(--space-section, 80px);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -300px;
    left: 50%;
    z-index: -1;
    width: min(880px, 135vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle,
      transparent 0,
      transparent 68px,
      var(--border-subtle) 69px,
      transparent 70px
    );
    opacity: 0.56;
    transform: translateX(-50%);
    mask-image: linear-gradient(to bottom, black 0%, rgba(0, 0, 0, 0.6) 50%, transparent 76%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, rgba(0, 0, 0, 0.6) 50%, transparent 76%);
    pointer-events: none;
  }

  .hero-identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-xxl);
  }

  .hero-content {
    text-align: center;
  }

  .hero-icon {
    width: 96px;
    height: 96px;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.10));
  }

  :global([data-theme="dark"]) .hero-icon {
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.4))
            drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
  }

  .hero-title {
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -1px;
    line-height: 1.1;
  }

  .hero-tagline {
    font-size: 20px;
    line-height: 1.45;
    color: var(--text-primary);
    max-width: 610px;
    margin: 0 auto var(--space-md);
  }

  .hero-subtext {
    font-size: 16px;
    line-height: 1.45;
    max-width: 500px;
    margin: 0 auto var(--space-xxxl);
  }

  .hero-cta {
    margin-bottom: var(--space-md);
  }

  .hero-release {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    margin: 0 auto var(--space-xl);
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .hero-release > * {
    white-space: nowrap;
  }

  .hero-release > * + *::before {
    content: '\00B7';
    content: '\00B7' / '';
    margin-inline: var(--space-sm);
    color: var(--text-tertiary, var(--text-secondary));
  }

  .hero-release a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--border-card);
    text-underline-offset: 3px;
  }

  .hero-release a:hover {
    color: var(--text-primary);
    text-decoration-color: var(--text-secondary);
  }

  .hero-release a:focus-visible {
    border-radius: var(--corner-radius-sm);
  }

  .hero-publication {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-section-sm, 48px);
    color: var(--text-secondary);
    font-size: 14px;
    text-decoration: underline;
    text-decoration-color: var(--border-card);
    text-underline-offset: 4px;
  }

  .hero-publication:hover {
    color: var(--text-primary);
    text-decoration-color: var(--text-secondary);
  }

  .hero-publication:focus-visible {
    border-radius: var(--corner-radius-sm);
  }

  .hero-screenshot-wrapper {
    max-width: var(--content-wide, 920px);
    margin-inline: auto;
  }

  .hero-screenshot {
    border-radius: var(--corner-radius-xl);
  }

  .hero-screenshot img {
    border-radius: calc(var(--corner-radius-xl) - 1px);
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 40px;
    }

    .hero-title {
      font-size: 36px;
    }

    .hero-tagline {
      font-size: 18px;
    }

    .hero-screenshot-wrapper {
      margin-inline: 0;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 30px;
    }

    .hero-release {
      flex-direction: column;
      align-items: center;
      gap: var(--space-xxs, 2px);
    }

    .hero-release > * + *::before {
      content: none;
    }

    .hero-release > * {
      white-space: normal;
    }

    .hero-tagline {
      font-size: 17px;
    }
  }
</style>
